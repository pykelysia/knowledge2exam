DEBUG_MODE=false

# 本地开发环境变量示例，复制为 .env 后按需修改
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5433/knowledge2exam
JWT_SECRET=your-jwt-secret-here
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
STORAGE_DIR=./storage
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# LLM（OpenAI 兼容协议）
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.openai.com/v1

# MainAgent 配置
AGENT_MODEL=gpt-4o

# Embedding（OpenAI 兼容 embeddings 协议）
EMBEDDING_API_KEY=sk-your-embedding-api-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# 向量维度：建库（chunk.embedding 列）与读写共用此值。
# 必须与所用嵌入模型一致，且部署后不可修改（pgvector 列维度不可变，换模型需重建 chunk 表）。
EMBEDDING_DIMENSIONS=1536
